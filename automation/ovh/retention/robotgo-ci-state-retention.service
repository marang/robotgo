[Unit]
Description=Expire private RobotGo CI runs after 14 days
ConditionUser=7051508

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/izoone-ci/prune-robotgo-state.py --apply
Environment=HOME=/home/izoone_workers
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/izoone_workers/.local/state/robotgo-ovh
CPUQuota=10%
MemoryMax=128M
TasksMax=16
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
