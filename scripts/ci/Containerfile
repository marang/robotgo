# Official Go 1.26.10 Debian 13 (Trixie) base, verified on 2026-10-31.
# Modern Weston supports the unchanged tests' headless/x11 backend names.
# Build with an empty context; no source, Git metadata or credentials are used.
FROM docker.io/library/golang@sha256:4ddd76d158c062213aaf055513809cdac05a445b2db3a0f12dbb624ed2e577d9

ENV GOTOOLCHAIN=local GOTELEMETRY=off GOMAXPROCS=2 GOFLAGS=-p=2
RUN test "$(go env GOVERSION)" = go1.26.10 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates git pkg-config \
        libx11-dev libxtst-dev libxkbcommon-dev libxkbcommon-tools \
        libwayland-dev wayland-protocols libgbm-dev libdrm-dev \
        libpipewire-0.3-dev libleptonica-dev libtesseract-dev \
        weston xvfb xauth x11-utils x11-xkb-utils xkb-data xclip xsel \
    && rm -rf /var/lib/apt/lists/*

# Tool builds do not consume project source or credentials. Package versions
# are explicit; OS package versions are fixed by the resulting admitted image
# ID, not claimed to be reproducible from an unversioned apt repository.
RUN GOBIN=/usr/local/bin go install golang.org/x/vuln/cmd/govulncheck@v1.9.0 \
    && GOBIN=/usr/local/bin go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.11.4 \
    && GOBIN=/usr/local/bin go install github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 \
    && go clean -cache -modcache

# Retain the admitted XKB oracle 1.6 independently of the distro version.
# Its isolated prefix preserves the unchanged X11 contract.
# Its xkbcommon libraries are static: RobotGo still links the distro libraries.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl meson ninja-build bison libxcb-xkb-dev \
    && curl --fail --show-error --silent --location \
        https://xkbcommon.org/download/libxkbcommon-1.6.0.tar.xz \
        --output /tmp/libxkbcommon-1.6.0.tar.xz \
    && echo '0edc14eccdd391514458bc5f5a4b99863ed2d651e4dd761a90abf4f46ef99c2b  /tmp/libxkbcommon-1.6.0.tar.xz' | sha256sum --check --strict \
    && tar -xJf /tmp/libxkbcommon-1.6.0.tar.xz -C /tmp \
    && meson setup /tmp/robotgo-xkb-build /tmp/libxkbcommon-1.6.0 \
        --prefix=/opt/robotgo-xkb-oracle --libdir=lib --buildtype=release \
        -Ddefault_library=static -Denable-docs=false -Denable-wayland=false \
        -Denable-xkbregistry=false -Denable-bash-completion=false \
        -Dxkb-config-root=/usr/share/X11/xkb -Dx-locale-root=/usr/share/X11/locale \
    && meson compile -C /tmp/robotgo-xkb-build -j 2 \
    && meson install -C /tmp/robotgo-xkb-build --no-rebuild \
    && ln -s /opt/robotgo-xkb-oracle/bin/xkbcli /usr/local/bin/xkbcli \
    && test "$(/usr/local/bin/xkbcli --version)" = 1.6.0 \
    && ldd /opt/robotgo-xkb-oracle/libexec/xkbcommon/xkbcli-interactive-x11 > /tmp/robotgo-xkb-linked-libs \
    && ! grep -q libxkbcommon /tmp/robotgo-xkb-linked-libs \
    && rm /tmp/robotgo-xkb-linked-libs \
    && rm -rf /tmp/libxkbcommon-1.6.0 /tmp/libxkbcommon-1.6.0.tar.xz /tmp/robotgo-xkb-build /var/lib/apt/lists/*

WORKDIR /w/source
USER 7051508:1004
